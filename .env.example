# Patriot Home Buyer — landing page form → GHL
# COPIA este archivo a .env.local y llena los valores. .env.local NUNCA se sube a git.
# En producción los mismos nombres van como Environment Variables en Vercel.

# Sub-cuenta destino (YA CONFIRMADO: Patriot Home Buyers)
GHL_LOCATION_ID=2JkfagGlzKQgxq6xJZVq

# Private Integration Token de ESA sub-cuenta (empieza con pit-...)
# GHL → Settings → Private Integrations → Create new integration
# Scopes mínimos: contacts.write, contacts.readonly, locations/customFields.readonly
GHL_PIT=

# Opcional: a qué pipeline/stage crear la oportunidad (déjalo vacío si aún no existe)
GHL_PIPELINE_ID=
GHL_STAGE_ID=
